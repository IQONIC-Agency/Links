# Neon Postgres (Vercel → Storage → Neon verbindet das automatisch)
DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (Vercel → Storage → Blob setzt das automatisch)
BLOB_READ_WRITE_TOKEN=

# Haupt-Admin-Login (sieht alle Kunden)
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-langes-passwort
# Optional: Schlüssel für Login-Cookies (leer = aus VISITOR_SALT abgeleitet)
AUTH_SECRET=

# Vercel-API: Kunden melden ihre Domains selbst an (leer = Domains von Hand in Vercel eintragen)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional: /admin nur auf dieser Domain erreichbar machen (z. B. admin.deinedomain.de)
ADMIN_HOST=

# Geheimer Salt für den anonymisierten Besucher-Hash (lang & zufällig, NIE ändern, sonst reißt die Besucher-Zählung ab)
VISITOR_SALT=

# proxycheck.io
PROXYCHECK_API_KEY=
# Kill-Switch: auf 1 setzen, dann wird proxycheck.io gar nicht mehr gefragt (alle durchlassen)
PROXYCHECK_DISABLED=0
# Timeout in ms
PROXYCHECK_TIMEOUT_MS=800

# Stats-API für externes Dashboard (leer = API aus)
STATS_API_KEY=

# Zeitzone für "Heute"/"Gestern" und Tagesverlauf
STATS_TIMEZONE=Europe/Berlin
